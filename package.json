  "scripts": {
    "start": "set BROWSER=none && react-scripts start --host 0.0.0.0",
    "start:dev": "set BROWSER=none && set REACT_APP_FIREBASE_AUTH_DOMAIN=mr-abdulhafeez.firebaseapp.com && react-scripts start --host 0.0.0.0",
    "start:prod": "set BROWSER=none && set REACT_APP_FIREBASE_AUTH_DOMAIN=sudanglish.com && react-scripts start --host 0.0.0.0",
    "test-server": "npx http-server -p 8080",
    "build": "react-scripts build",
    "build:dev": "set REACT_APP_FIREBASE_AUTH_DOMAIN=mr-abdulhafeez.firebaseapp.com && react-scripts build",
