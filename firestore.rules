rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User collection rules
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Session types
    match /sessionTypes/{sessionTypeId} {
      allow read, write: if true;
    }
    
    // Sessions
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
    
    // Availability
    match /availability/{availabilityId} {
      allow read, write: if true;
    }
    
    // Bookings (simple rules - allow all operations)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // All other collections - allow everything for development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}