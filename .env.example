# Firebase Configuration Template
# ===============================
# Copy this file to .env and fill in your actual values

# Firebase API Configuration (get these from Firebase Console)
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_domain_here
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_bucket_here
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id_here

# Application Settings
REACT_APP_VERSION=1.0.0

# Setup Instructions:
# 1. Get your Firebase config from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
# 2. Add your domain to Firebase Auth: Authentication → Settings → Authorized domains
# 3. Configure Google OAuth in Google Cloud Console if using Google sign-in